{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agente de Impresión Facturación",
  "version": "1.2.1",
  "identifier": "rd.silvestredigital.agente-impresion",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Agente de Impresión",
        "width": 460,
        "height": 820,
        "resizable": false,
        "visible": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": [
        "default"
      ]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFODg5MDU2ODczNTZGRDIKUldUU2J6V0hWcENJcm96WDl0QkRIdTl5VU52ZHZURXBYR2p0T1NVUk5MUExGZnlmVzVkendLWk0K",
      "endpoints": [
        "https://github.com/SilvestreDigitalRd/agente-impresion-pos/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}